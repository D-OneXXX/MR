{
  "name": "manga-reader-tauri",
  "private": true,
  "version": "0.17.3",
  "description": "Moyu - a free desktop application for manga reading and library management.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:check && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:community": "node scripts/build-community.mjs",
    "version:sync": "node scripts/version-sync.mjs",
    "version:check": "node scripts/version-check.mjs",
    "test:version": "node --test scripts/version.test.mjs",
    "test:governance": "node --test scripts/sync-labels.test.mjs scripts/project-status.test.mjs scripts/pr-governance.test.mjs tests/qa/lib/reliability.test.mjs",
    "test:fixtures": "node --test tests/qa/lib/fixtures.test.mjs",
    "test:release": "node --test scripts/release-contract.test.mjs scripts/release-governance/rc-record.test.mjs scripts/release-governance/evidence.test.mjs scripts/release-governance/minisign-tooling.test.mjs scripts/release-governance/verify-provenance.test.mjs scripts/release-smoke/prepare-candidate.test.mjs scripts/release-smoke/library-fixture.test.mjs scripts/release-smoke/library-ui-check.test.mjs",
    "release:rehearse": "node scripts/release-governance/rehearse.mjs",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "status": "node scripts/project-status.mjs",
    "labels:sync": "node scripts/sync-labels.mjs",
    "labels:check": "node scripts/sync-labels.mjs --check",
    "qa:audit": "node tests/qa/run-qa.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "^4.22.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.4"
  }
}
